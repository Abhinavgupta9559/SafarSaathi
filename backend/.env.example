# ============================================
# SafarSaathi Backend - Environment Variables
# Copy this file to ".env" and fill in your values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Security
# Generate a strong random string, e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=mera_secret_key_12345_abcxyz_987_lambi
JWT_EXPIRES_IN=7d

# Allowed frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# AI Assistant (optional but recommended)
# Get a key from https://console.anthropic.com/
# If left empty, the AI assistant automatically falls back to a rule-based
# journey planner that still works using the local transport dataset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
